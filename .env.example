# PostgreSQL shared by every instance. Create a dedicated database and application role.
DATABASE_URL=postgresql://looplab:change-me@127.0.0.1:5432/looplab
# At least 32 random characters; must be identical on instances sharing the database.
APP_SECRET=replace-with-a-long-random-secret
# AI Responses API: configure each value independently.
# Leave the base URL empty to use OPENAI_ENV_FILE or https://api.openai.com/v1.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional: read missing AI settings from an existing env file (absolute path).
OPENAI_ENV_FILE=

HOST=127.0.0.1
PORT=4310
COOKIE_SECURE=false
# Leave empty to use Playwright's installed Chromium; use chrome for installed Google Chrome.
PLAYWRIGHT_CHANNEL=
RUN_TIMEOUT_MS=600000
# Optional: local directory for per-account Git memory repositories.
LOOPLAB_PERSONAL_MEMORY_DIR=
# Isolated demo target for acceptance; disable on shared deployments.
DEMO_TARGET_ENABLED=false
