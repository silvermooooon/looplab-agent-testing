{
  "name": "agent-test-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && vite build && node dist/scripts/compress-web.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "test": "npm run build:server && node --test dist/test/*.test.js",
    "demo": "npm run build && node dist/examples/offline.js",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/src/server/main.js",
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "migrate": "tsx scripts/migrate.ts",
    "test:live": "tsx scripts/live-model.ts",
    "test:acceptance": "tsx scripts/acceptance.ts",
    "setup:local": "tsx scripts/init-local.ts",
    "verify:export": "tsx scripts/verify-export.ts",
    "verify:collaboration": "tsx scripts/verify-collaboration.ts",
    "verify:management": "tsx scripts/verify-management.ts",
    "verify:chat": "tsx scripts/verify-chat.ts"
  },
  "dependencies": {
    "@ant-design/x": "2.9.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.3.0",
    "@tanstack/react-query": "5.104.5",
    "ajv": "8.17.1",
    "antd": "6.6.7",
    "dotenv": "16.6.1",
    "fastify": "5.12.7",
    "lucide-react": "0.468.0",
    "openai": "6.49.0",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
